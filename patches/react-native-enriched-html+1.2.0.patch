 @implementation EnrichedInputTextView
 
+- (NSString *)inputAccessoryViewID {
+  return ((EnrichedTextInputView *)_input).nativeId;
+}
+
+- (void)setInputAccessoryView:(UIView *)inputAccessoryView {
+  [super setInputAccessoryView:inputAccessoryView];
+  [self shareInputAccessoryView];
+}
+
+- (BOOL)resignFirstResponder {
+  if (self.isFirstResponder) {
+    [self shareInputAccessoryView];
+  }
+  return [super resignFirstResponder];
+}
+
+- (void)shareInputAccessoryView {
+  NSString *identifier = self.inputAccessoryViewID;
+  if (self.inputAccessoryView != nil && identifier != nil && self.window != nil) {
+    [self shareInputAccessoryView:self.inputAccessoryView prefix:[identifier stringByAppendingString:@"."] inView:self.window];
+  }
+}
+
+- (void)shareInputAccessoryView:(UIView *)accessory prefix:(NSString *)prefix inView:(UIView *)view {
+  if (view != self && [view respondsToSelector:@selector(inputAccessoryViewID)] &&
+      [view respondsToSelector:@selector(setInputAccessoryView:)] && view.inputAccessoryView != accessory) {
+    id identifier = [view performSelector:@selector(inputAccessoryViewID)];
+    if ([identifier isKindOfClass:[NSString class]] && [identifier hasPrefix:prefix]) {
+      [view performSelector:@selector(setInputAccessoryView:) withObject:accessory];
+      if (view.isFirstResponder) {
+        [view reloadInputViews];
+      }
+    }
+  }
+  for (UIView *subview in view.subviews) {
+    [self shareInputAccessoryView:accessory prefix:prefix inView:subview];
+  }
+}
